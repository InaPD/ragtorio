# Copy to .env and fill in. .env is gitignored.

# Contact address embedded in the User-Agent sent to wiki APIs.
# Wiki operators expect a way to reach you; do not leave this as the default.
FA_CONTACT_EMAIL=you@example.com

# Postgres (see docker-compose.yml)
FA_POSTGRES_DSN=postgresql://field_assistant:field_assistant@localhost:5433/field_assistant

# Neo4j (see docker-compose.yml)
FA_NEO4J_URI=bolt://localhost:7687
FA_NEO4J_USER=neo4j
FA_NEO4J_PASSWORD=field_assistant

# Only needed from Phase 5 onward (routing and answering).
ANTHROPIC_API_KEY=
