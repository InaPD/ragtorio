# Copy to .env and fill in. .env is gitignored.

# Contact address embedded in the User-Agent sent to wiki APIs.
# Wiki operators expect a way to reach you; do not leave this as the default.
RAGTORIO_CONTACT_EMAIL=you@example.com

# Postgres (see docker-compose.yml)
RAGTORIO_POSTGRES_DSN=postgresql://ragtorio:ragtorio@localhost:5433/ragtorio

# Neo4j (see docker-compose.yml)
RAGTORIO_NEO4J_URI=bolt://localhost:7687
RAGTORIO_NEO4J_USER=neo4j
RAGTORIO_NEO4J_PASSWORD=ragtorio

# Only needed from Phase 5 onward (routing and answering).
ANTHROPIC_API_KEY=

# Only needed for `ragtorio index build --provider voyage`. The default embedding
# provider is a local model and needs no key at all.
VOYAGE_API_KEY=
